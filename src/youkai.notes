D 0x4000 0x4010 cabecera           La cabecera del cartucho: "AB", INIT 0x4010, sin STATEMENT, DEVICE ni TEXT
D 0x4038 0x4044 salas_planos      Los planos de las seis salas (0xE00A): un puntero cada uno (0x4044, 0x4062, 0x40C6, 0x410C, 0x413E y 0x418E)
D 0x4044 0x41AC planos            Los planos: filas de 10 casillas con el numero de pantalla de cada sitio (0, nada); se leen por la fila (0xE0A2) y la columna (0xE0A1)
D 0x41AC 0x4240 pantallas         Los punteros de las descripciones de las 74 pantallas, por su numero (0xE0A3)
D 0x4240 0x4EBE pantallas_desc    Las descripciones de las pantallas: piezas, rellenos (0xFE), escaleras y dibujos, cada lista con su 0xFF
D 0x4EBE 0x4F52 pantallas_seres   Los punteros de los enemigos y objetos de las 74 pantallas
D 0x4F52 0x54C7 seres             Las listas: enemigos (Y, X y tipo; a 0xE340) hasta 0xFF y objetos (cuatro bytes; a 0xE400) hasta 0xFF
D 0x54C7 0x554F pant_piezas        Los punteros de las piezas de las pantallas (0x54C7 + 2 x pieza) y sus dibujos
D 0x554F 0x5695 dibujos           Dibujos de casillas: el blanco de 11 x 11 (0x554F) y los de los objetos (0x55DC, 0x55E2, 0x55F0, 0x55FB, 0x5606, 0x5611)
D 0x5695 0x5705 titulo_txt        El nombre (妖怪屋敷, 4 filas de 16 casillas), CASIO (0x56D5, las casillas 0x8A-0x8F), PUSH TRIG:1 OR SPACE (0x56DB) y COPYRIGHT 1986 (c) CASIO (0x56EF)
D 0x5705 0x5800 marcador_textos   HISCORE: (0x5705; SCORE, 0x5707, es su final) con siete ceros, GAME OVER (0x5714) y relleno (0x00 y 0xFF) que nadie lee
D 0x5800 0x6000 sprites           Los dibujos de los 64 sprites de 16 x 16 (0x800 bytes, a 0x3800)
D 0x6000 0x6680 casillas          Los dibujos de las casillas 0x30-0xFF (0x680 bytes)
D 0x6680 0x6800 casillas_mas      Mas dibujos: 0x6680 (0x80 bytes) y 0x6700 (0x100 bytes, el nombre del titulo)
D 0x6800 0x7000 sucesos_dibujos   Los dibujos de los sucesos de las salas (0x2C0 bytes desde 0x6800, 0x6A80, 0x6B80 o 0x6C00, a las casillas 0x90-0xE7) y 0x6E80 (0x180 bytes)
D 0x7000 0x7680 colores           Los colores de las casillas 0x30-0xFF (0x680 bytes)
D 0x7680 0x7700 colores_mas       Mas colores (0x80 bytes)
D 0x7700 0x7800 sucesos_8x8       Los dibujos de 8 x 8 casillas de los sucesos de las salas 0-3 (0x7700, 0x7780, 0x7740 y 0x77C0)
D 0x7800 0x7E80 sucesos_colores   Los colores de los dibujos de los sucesos (0x1000 bytes despues de los suyos)
D 0x7FF4 0x8000 sobra_7ff4        12 bytes 0xF0 que nadie lee (detras del arranque)
D 0x8F91 0x8FC4 saltos            Las tablas del salto: cuanto sube en cada paso, recto (0x8F91) y de lado (0x8FA2)
D 0x93D1 0x9400 sobra_93d1        47 bytes de codigo que nadie ejecuta (ningun salto llega; la medida de cobertura no pasa)
D 0x947B 0x94A3 objetos_tabla     Las rutinas de los 20 tipos de objeto de 0xE400
D 0x9989 0x9999 objetos_tabla2    Cuatro ceros y los dibujos de lo que se coge (0x9991, dos casillas por cosa)
D 0x9A81 0x9A89 objetos_dibujos   Dos casillas por tipo para el dibujo de un objeto
D 0x9CB4 0x9CF8 objetos_dibujos2  Tres punteros (0x9CBA, 0x9CCB, 0x9CDC) y sus dibujos
D 0x9E24 0x9E2C objetos_dibujo3   Un dibujo de 3 x 2 casillas
D 0x9F14 0x9F40 objetos_dibujo4   Dos dibujos (0x9F14 y 0x9F2A)
D 0xA078 0xA080 objetos_dibujo5   Dos dibujos de 2 x 1 (0xA078 y 0xA07C)
D 0xA0D7 0xA1B9 puertas           Las puertas: punteros (0xA0D7) a cuatro bytes cada una (la sala, la columna y la fila de destino, y donde aparece)
D 0xA1E8 0xA216 enemigos_tabla    Las rutinas de los 23 tipos de enemigo de 0xE340
D 0xA434 0xA444 salto_enemigo     Lo que sube un enemigo en cada paso de su salto
D 0xA4C2 0xA4C3 sobra_a4c2        Un "ret" que nadie ejecuta
D 0xA839 0xA853 enemigos_dibujos  Las casillas de dos dibujos de enemigos (0xA839 y 0xA846)
D 0xA9D6 0xA9ED sobra_a9d6        23 bytes de codigo que nadie ejecuta (ningun salto llega; la medida de cobertura no pasa)
D 0xAF4D 0xAF73 continuar         CONTINUE PUSH TRIG1 (0xAF4D) y END      PUSH TRIG2 (0xAF60)
D 0xAFA3 0xAFB6 sobra_afa3        19 bytes de codigo que nadie ejecuta (si un objeto se sale de la pantalla, fuera); ningun salto llega
D 0xB6C7 0xB6E2 casio_filas       Las filas de CASIO de la presentacion
D 0xB6E2 0xB700 sobra_b6e2        30 bytes de relleno (FB 00) que nadie lee
D 0xB700 0xB730 musicas           Las 8 musicas: las piezas de los canales A, B y C (6 bytes cada una; la 0, nada)
D 0xB730 0xB740 efectos_a         Los 8 efectos del canal A: su pieza (2 bytes)
D 0xB740 0xB758 efectos_bc        Los 6 efectos de los canales B y C: sus dos piezas (4 bytes)
D 0xBA2D 0xBA3B duraciones        Las duraciones de las notas (la mitad alta del byte, 0-13)
D 0xBB36 0xC000 piezas            Las piezas de las musicas y los efectos (los punteros de 0xB700-0xB757): notas, ruidos y ordenes 0xF0-0xFF
L 0x8852 pantalla_abajo            La pantalla de abajo (0xE0A2 + 1), si la hay: 0xE0A3 y 0xE198 = 3; si no, A = 0
L 0x88E9 sala_puerta_mira          C si la pantalla A es la de la puerta de la sala de antes (0: 9, 1: 0x12, 2: 0x1E, 3: 0x2F, 4: 0x44)
L 0x892D casillas_cuerpo           Las casillas del cuerpo del protagonista (por encima de la Y 0x0C, la fila 0)
L 0x8AB4 casillas_der              Las dos casillas de la derecha del protagonista (la fila Y - 16)
L 0x8C44 casillas_izq              Las dos de la izquierda
L 0x8EE7 escalera_mira             En la escalera (+0x0A), segun su lado (+0x17)
L 0x8F09 empuje_der                Empujado a la derecha: si las casillas de la derecha (0x48-0x7F) lo permiten, 1 a la derecha
L 0x8F42 empuje_izq                Empujado a la izquierda
L 0x8F7B salto_mira                Puede saltar? (0xE0AB, la vida)
L 0x8FC4 pantalla_cambia           Con 0xE198 (el lado), la pantalla nueva entra deslizandose por su lado
L 0x9400 pantalla_seres            La primera vez en la pantalla: sus enemigos (a 0xE340) y objetos (a 0xE400) de la tabla de 0x4EBE
L 0x946D objeto_salta              A la rutina del tipo A (tabla 0x947B)
L 0x977C cosa_coge                 Coger una cosa: 0xE02B + 1; a la quinta, lo que da
L 0x9863 sala_hueco                4 filas de 2 casillas en blanco (0x80) en la sala de la RAM
L 0x9871 pantalla_hueco            Lo mismo en la pantalla
L 0xA1B9 enemigos                  Los 12 enemigos de 0xE340 (+4 el tipo): cada uno a su rutina por la tabla de 0xA1E8
L 0xA1DA enemigo_salta             A la rutina del tipo A (tabla 0xA1E8)
L 0xA216 enemigo_espera            Esperando: color 15 y los dibujos 0x38/0x3C cada 8 cuadros; A = la distancia en X al protagonista
L 0xA23D enemigo_pasa_izq          C si el enemigo puede ir a la izquierda (las casillas de X - 8)
L 0xA271 enemigo_pasa_der          C si puede ir a la derecha (X + 0x10)
L 0xAFE8 cerca_x                   ¿Toca en X? La X de IY menos la del protagonista entre B y C
L 0xAFF0 arma_cerca_y              ¿El arma toca en Y?
L 0xAFF8 arma_cerca_x              ¿El arma toca en X?
L 0xB01C pantalla_limpia2          La RAM a cero y los botones a 0 (sin borrar la pantalla)
L 0xB056 marcador                  HISCORE: (0x5705) en la fila 0, columna 17, SCORE en la 1, el aguante y los puntos
L 0xB07A vida_pinta                El aguante: las filas 0 y 1 desde la columna 1 en blanco y sus casillas (0xE0A9 / 2 enteras y media)
L 0xB0AE vida_casillas             0xE0A9 / 2 casillas 0x64 arriba y 0x63 abajo; con impar, media
L 0xB0FE vida_llena                El aguante lleno (0xE0A9 = las vidas, 0xE0A8, x 2), pintado, 0xE0AA a 0 y el efecto 3
L 0xB11A vida_media                Medio aguante mas (0xE0A9 + 1), si no esta lleno, con el sonido 1
L 0xB136 vida_resta                El aguante - 1, pintado, y el sonido 7
L 0xB146 golpe                     Un golpe al protagonista: nada con las teclas del titulo, tocado o parpadeando; con aguante, medio menos y el parpadeo; sin el, la muerte
L 0xB19A objetos_borra             Los 256 bytes de 0xE400 a cero
L 0xB1A5 enemigos_borra            Los 0xC0 bytes de 0xE340 a cero y sus 12 enemigos fuera
L 0xB1C3 pantalla_abre             La sala de la RAM a la pantalla desde los bordes hacia el centro
L 0xB25D pantalla_cierra_centro    La zona de juego se borra desde el centro hacia los lados
L 0xB2F0 letras_pon                La fuente de la BIOS (0x1D3F, 0x180 bytes) a DE; y DE al tercio siguiente
L 0xB301 casillas_pon              Los dibujos de las casillas 0x30-0xFF (0x6000)
L 0xB30A colores_pon               Sus colores (0x7000)
L 0xB313 fila_16                   16 casillas de HL a DE y DE a la fila siguiente
L 0xB32C colores_titulo            0x280 bytes de 0xF0 en los colores
L 0xB334 titulo_casillas           Las casillas del nombre: 0x6700 (0x100), 0x6E80 (0x180), 0x6680 y 0x7680
L 0xB36D sprites_dibujos           Los dibujos de los sprites (0x5800, 0x800 bytes) a 0x3800
L 0xB379 sonido_reinicia           0xE097 = 0xFF: la interrupcion pone el sonido a cero
L 0xB37F prota_sprites             Los cuatro sprites del protagonista a la tabla de atributos
L 0xB558 empezar_lee               El boton de empezar (0xE026): la barra o el boton 1 del mando
L 0xB601 presentacion_vert         Desde el paso 9: el CASIO que baja y el que sube
L 0xBA84 sonido_cero               El mezclador A y los canales (0xE280, 0x43 bytes) a cero
